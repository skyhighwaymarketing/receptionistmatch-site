---
import Base from '../layouts/Base.astro';
import { render } from 'astro:content';
import { livePosts, KIND, fmt } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await livePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const url = new URL(`/${post.id}/`, Astro.site).href;
const article = {
  '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
  datePublished: d.published.toISOString(), dateModified: (d.updated ?? d.published).toISOString(),
  mainEntityOfPage: url, image: new URL(`/og/${post.id}.png`, Astro.site).href, author: { '@type': 'Organization', name: 'ReceptionistMatch', url: 'https://receptionistmatch.com/about/' },
  publisher: { '@type': 'Organization', name: 'ReceptionistMatch', url: 'https://receptionistmatch.com/' },
};
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Guides', item: 'https://receptionistmatch.com/guides/' },
  { '@type': 'ListItem', position: 2, name: d.title, item: url } ] };
---
<Base title={d.title} description={d.description} ogType="article" image={`/og/${post.id}.png`} jsonld={[article, crumbs]}>
<article class="article" data-type={d.type}>
  <span class="kind">{KIND[d.type]}</span>
  <h1>{d.title}</h1>
  <div class="meta">
    <span class="stamp">Prices checked {fmt(d.pricesChecked)}</span>
    <span>{d.updated ? `Updated ${fmt(d.updated)}` : `Published ${fmt(d.published)}`}</span>
  </div>
  <p class="disclosure">
    Some vendors on this page pay us a commission if you sign up through our links. It never changes the order:
    we rank by fit for your business. <a href="/disclosure/">Which vendors pay us, and how much</a>.
  </p>
  <div class="prose"><Content /></div>
</article>
</Base>
